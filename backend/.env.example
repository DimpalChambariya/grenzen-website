# Server Port
PORT=4000

# SMTP Email Configuration
# Common hosts:
# - Google Workspace / Gmail: smtp.gmail.com (Port: 465, Secure: true, use an App Password)
# - Hostinger: smtp.hostinger.com (Port: 465, Secure: true)
# - Zoho: smtppro.zoho.com (Port: 465, Secure: true)
# - Microsoft 365 / Outlook: smtp.office365.com (Port: 587, Secure: false)
# - cPanel / Custom Webmail: mail.grenzenpharmachem.com (Port: 465, Secure: true)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@grenzenpharmachem.com
SMTP_PASS=your_password_here

# Email recipients
EMAIL_FROM="Grenzen Pharmachem Website" <info@grenzenpharmachem.com>
EMAIL_TO=info@grenzenpharmachem.com
